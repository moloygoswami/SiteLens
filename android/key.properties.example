# Example key.properties template for SiteLens Android release signing
# Copy this file to android/key.properties and supply your secure keystore credentials.
# Do NOT commit android/key.properties or your .keystore/.jks files to version control.

storeFile=../release-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
